	if not ok or type(source) ~= "string" or source == "" then
		error("[FunctionHub loader] Could not download " .. mode .. ", try again", 0)
	end
	local chunk, problem = loadstring(source, "FunctionHub/" .. mode)
	if not chunk then
		error("[FunctionHub loader] Could not load " .. mode .. ": " .. tostring(problem), 0)
	end
	return chunk()
