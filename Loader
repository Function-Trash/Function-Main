local MAIN_URLS = {
    Normal = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/Normal.lua",
    Kaitun = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/KaitunBF.lua",
    AutoBounty = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/AutoBounty.lua",
}
local function rawUrl(url)
    local owner, repo, branch, path = url:match("^https://github%.com/([^/]+)/([^/]+)/blob/([^/]+)/(.+)$")
    if owner then
        return "https://raw.githubusercontent.com/" .. owner .. "/" .. repo .. "/" .. branch .. "/" .. path
    end
    return url
end
local function run(mode, url)
    if type(url) ~= "string" or url:match("^%s*$") then
        error("[FunctionHub loader] Add the " .. mode .. " script URL before running.", 0)
    end
    url = url:match("^%s*(.-)%s*$")
    local ok, source = pcall(function()
        return game:HttpGet(rawUrl(url))
    end)
    if not ok then
        error("[FunctionHub loader] Could not download " .. mode .. ": " .. tostring(source), 0)
    end
    if type(source) ~= "string" or source == "" then
        error("[FunctionHub loader] Empty response for " .. mode, 0)
    end
    local chunk, problem = loadstring(source, "FunctionHub/" .. mode)
    if not chunk then
        error("[FunctionHub loader] Could not compile " .. mode .. ": " .. tostring(problem), 0)
    end
    return chunk()
end
local mode = _G.Script_Mode
if mode == nil or (type(mode) == "string" and mode:match("^%s*$")) then
    mode = "Normal"
elseif type(mode) ~= "string" then
    error("[FunctionHub loader] _G.Script_Mode must be a string.", 0)
end
local normalized = mode:lower():gsub("[%s%-]", "")
local key = ({
    normal = "Normal",
    bf = "Normal",
    kaitun = "Kaitun",
    kaitunbf = "Kaitun",
    autobounty = "AutoBounty"
})[normalized]
if not key then
    error("[FunctionHub loader] _G.Script_Mode must be Normal, Kaitun, or AutoBounty", 0)
end
return run(key, MAIN_URLS[key])
