local function L(t)
	local n, out = #t, table.create and table.create(#t) or {}
	local prev = t[n]
	for i = n - 1, 1, -1 do
		local b = t[i]
		out[#out + 1] = string.char(bit32.bxor(b, K[(n - 1 - i) % #K + 1], prev))
		prev = b
	end
	return table.concat(out)
end
local function run(mode)
