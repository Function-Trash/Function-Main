-- Each game: the IDs that identify it, the script it loads by default, and its scripts.
-- gameIds = universe ID (game.GameId), the same for every place/sea/lobby in that game.
-- placeIds = backup check if the universe ID doesn't match.
local GAMES = {
    BloxFruits = {
        gameIds = { 994732206 },
        placeIds = {
            2753915549, 85211729168715,   -- First Sea
            4442272183, 79091703265657,   -- Second Sea
            7449423635, 100117331123089,  -- Third Sea
        },
        default = "Normal",
        scripts = {
            Normal = {
                url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/Normal.lua",
                aliases = { "normal", "bf", "bloxfruits" },
            },
            Kaitun = {
                url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/KaitunBF.lua",
                aliases = { "kaitun", "kaitunbf" },
            },
            AutoBounty = {
                url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/AutoBounty.lua",
                aliases = { "autobounty", "bounty" },
            },
        },
    },
    Fisch = {
        gameIds = { 5750914919 },
        placeIds = { 16732694052 },
        default = "Fisch",
        scripts = {
            Fisch = {
                url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/Fisch.lua",
                aliases = { "fisch", "fish" },
            },
        },
    },
    AA = {
        gameIds = { 3183403065 },
        placeIds = {
            8304191830,       -- main Anime Adventures (Gomu)
            117965110267191,  -- separate Gomu Development listing: remove if your AA script doesn't support it
        },
        default = "AA",
        scripts = {
            AA = {
                url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/AA.lua",
                aliases = { "aa", "animeadventures" },
            },
        },
    },
}

local function normalize(s)
    return (s:lower():gsub("[%s%-_]", ""))
end

-- build alias lookup automatically: alias -> { game = "BloxFruits", script = "Kaitun" }
local ALIASES, NAMES = {}, {}
for gameName, g in pairs(GAMES) do
    for scriptName, info in pairs(g.scripts) do
        local entry = { game = gameName, script = scriptName }
        ALIASES[normalize(scriptName)] = entry
        for _, a in ipairs(info.aliases or {}) do
            ALIASES[normalize(a)] = entry
        end
        table.insert(NAMES, scriptName)
    end
end
table.sort(NAMES)

local function rawUrl(url)
    local owner, repo, branch, path = url:match("^https://github%.com/([^/]+)/([^/]+)/blob/([^/]+)/(.+)$")
    if owner then
        return "https://raw.githubusercontent.com/" .. owner .. "/" .. repo .. "/" .. branch .. "/" .. path
    end
    return url
end

local function run(mode, url)
    if type(url) ~= "string" or url:match("^%s*$") then
        error("[FunctionHub loader] Add the " .. mode .. " script URL before running.", 0)
    end
    url = rawUrl(url:match("^%s*(.-)%s*$"))

    local ok, source = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok then
        error("[FunctionHub loader] Could not download " .. mode .. ": " .. tostring(source), 0)
    end
    if type(source) ~= "string" or source == "" or source:match("^404") then
        error("[FunctionHub loader] Bad/empty response for " .. mode .. " (" .. url .. ")", 0)
    end

    local chunk, problem = loadstring(source, "FunctionHub/" .. mode)
    if not chunk then
        error("[FunctionHub loader] Could not compile " .. mode .. ": " .. tostring(problem), 0)
    end
    return chunk()
end

local function detectGame()
    local placeId, gameId = game.PlaceId, game.GameId
    for gameName, g in pairs(GAMES) do
        for _, id in ipairs(g.gameIds or {}) do
            if id == gameId then return gameName end
        end
    end
    for gameName, g in pairs(GAMES) do
        for _, id in ipairs(g.placeIds or {}) do
            if id == placeId then return gameName end
        end
    end
    return nil
end

-- read _G.Script_Mode (optional)
local mode = _G.Script_Mode
if type(mode) == "string" and mode:match("^%s*$") then
    mode = nil
elseif mode ~= nil and type(mode) ~= "string" then
    error("[FunctionHub loader] _G.Script_Mode must be a string.", 0)
end

local wanted = mode and ALIASES[normalize(mode)]
if mode and not wanted then
    error("[FunctionHub loader] _G.Script_Mode must be one of: " .. table.concat(NAMES, ", "), 0)
end

local detected = detectGame()

if detected then
    local g = GAMES[detected]
    local scriptName = g.default
    if wanted then
        if wanted.game == detected then
            scriptName = wanted.script
        else
            warn(("[FunctionHub loader] '%s' is not for this game, loading %s instead."):format(mode, g.default))
        end
    end
    return run(scriptName, g.scripts[scriptName].url)
end

-- unknown game: allow a manual override, otherwise show the IDs so they can be added above
if wanted then
    warn(("[FunctionHub loader] Game not recognised (PlaceId %d, GameId %d), forcing %s."):format(game.PlaceId, game.GameId, wanted.script))
    return run(wanted.script, GAMES[wanted.game].scripts[wanted.script].url)
end

error(("[FunctionHub loader] This game is not supported. PlaceId: %d, GameId: %d"):format(game.PlaceId, game.GameId), 0)
