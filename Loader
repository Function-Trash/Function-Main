local GAMES = {
    Normal = {
        url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/Normal.lua",
        aliases = { "normal", "bf", "bloxfruits" },
    },
    Kaitun = {
        url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/KaitunBF.lua",
        aliases = { "kaitun", "kaitunbf" },
    },
    AutoBounty = {
        url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/AutoBounty.lua",
        aliases = { "autobounty", "bounty" },
    },
    Fisch = {
        -- check the exact filename in the repo (Fisch vs Fisch.lua)
        url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/Fisch.lua",
        aliases = { "fisch", "fish" },
    },
    AA = {
        url = "https://raw.githubusercontent.com/Function-Trash/Function-Main/main/AA.lua",
        aliases = { "aa", "animeadventures" },
    },
}

-- build alias lookup automatically
local ALIASES, NAMES = {}, {}
for name, info in pairs(GAMES) do
    ALIASES[name:lower()] = name
    for _, a in ipairs(info.aliases or {}) do
        ALIASES[a] = name
    end
    table.insert(NAMES, name)
end
table.sort(NAMES)

local function rawUrl(url)
    local owner, repo, branch, path = url:match("^https://github%.com/([^/]+)/([^/]+)/blob/([^/]+)/(.+)$")
    if owner then
        return "https://raw.githubusercontent.com/" .. owner .. "/" .. repo .. "/" .. branch .. "/" .. path
    end
    return url
end

local function run(mode, url)
    if type(url) ~= "string" or url:match("^%s*$") then
        error("[FunctionHub loader] Add the " .. mode .. " script URL before running.", 0)
    end
    url = rawUrl(url:match("^%s*(.-)%s*$"))

    local ok, source = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok then
        error("[FunctionHub loader] Could not download " .. mode .. ": " .. tostring(source), 0)
    end
    if type(source) ~= "string" or source == "" or source:match("^404") then
        error("[FunctionHub loader] Bad/empty response for " .. mode .. " (" .. url .. ")", 0)
    end

    local chunk, problem = loadstring(source, "FunctionHub/" .. mode)
    if not chunk then
        error("[FunctionHub loader] Could not compile " .. mode .. ": " .. tostring(problem), 0)
    end
    return chunk()
end

local mode = _G.Script_Mode
if mode == nil or (type(mode) == "string" and mode:match("^%s*$")) then
    mode = "Normal"
elseif type(mode) ~= "string" then
    error("[FunctionHub loader] _G.Script_Mode must be a string.", 0)
end

local normalized = (mode:lower():gsub("[%s%-_]", ""))
local key = ALIASES[normalized]
if not key then
    error("[FunctionHub loader] _G.Script_Mode must be one of: " .. table.concat(NAMES, ", "), 0)
end

return run(key, GAMES[key].url)
